{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:market_data.provider_budget_level_changed:v1",
  "title": "market_data.provider_budget_level_changed v1",
  "description": "Nível do orçamento da brapi mudou (Brapi §5.3, RN-BRP-035).",
  "x-producer": "market-data-service",
  "x-auditable": false,
  "type": "object",
  "required": [
    "from",
    "to",
    "remaining",
    "projectedExhaustion"
  ],
  "properties": {
    "from": {
      "anyOf": [
        {
          "type": "string",
          "const": "NORMAL"
        },
        {
          "type": "string",
          "const": "SAVING"
        },
        {
          "type": "string",
          "const": "CRITICAL"
        },
        {
          "type": "string",
          "const": "EXHAUSTED"
        }
      ]
    },
    "to": {
      "anyOf": [
        {
          "type": "string",
          "const": "NORMAL"
        },
        {
          "type": "string",
          "const": "SAVING"
        },
        {
          "type": "string",
          "const": "CRITICAL"
        },
        {
          "type": "string",
          "const": "EXHAUSTED"
        }
      ]
    },
    "remaining": {
      "type": "integer",
      "minimum": 0
    },
    "projectedExhaustion": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
