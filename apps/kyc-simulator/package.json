{
  "name": "@broker/kyc-simulator",
  "version": "0.0.0",
  "private": true,
  "description": "Provedor de KYC simulado: submissão 202 com check_id, regras pelo penúltimo dígito do CPF, webhook por verificação, leitura de documentos só por URL assinada e UI de inspeção (Sistemas simulados §3, Onboarding §5).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@broker/clock": "workspace:*",
    "@broker/contracts": "workspace:*",
    "@broker/domain-kernel": "workspace:*",
    "@broker/ids": "workspace:*",
    "@broker/persistence": "workspace:*",
    "@broker/service-kit": "workspace:*",
    "@broker/simulator-kit": "workspace:*",
    "@broker/webhooks": "workspace:*",
    "kysely": "0.29.6",
    "pg": "^8.23.1",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@broker/testing": "workspace:*",
    "@broker/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
