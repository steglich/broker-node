{
  "name": "@broker/matching-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Motor de negociação: livros em memória, matching preço-tempo, túneis, leilões, journal, snapshots e recuperação (Motor §2–§10, ADR-0005).",
  "type": "module",
  "exports": {
    "./domain/*": {
      "source": "./src/domain/*.ts",
      "types": "./dist/domain/*.d.ts",
      "default": "./dist/domain/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "tsx --conditions=source bench/matching.ts"
  },
  "dependencies": {
    "@broker/clock": "workspace:*",
    "@broker/contracts": "workspace:*",
    "@broker/domain-kernel": "workspace:*",
    "@broker/ids": "workspace:*",
    "@broker/messaging": "workspace:*",
    "@broker/persistence": "workspace:*",
    "@broker/service-kit": "workspace:*",
    "iovalkey": "0.4.0",
    "kysely": "0.29.6",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@broker/testing": "workspace:*",
    "@broker/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/supertest": "7.2.1",
    "jose": "6.2.12",
    "rabbitmq-stream-js-client": "1.1.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
