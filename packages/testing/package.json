{
  "name": "@broker/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Utilitários de teste: builders (RN-QA-020), relógio virtual, geradores determinísticos (CPF, PRNG com semente), contêineres (PostgreSQL, RabbitMQ, Valkey) e utilitários de E2E.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./containers": {
      "source": "./src/containers.ts",
      "types": "./dist/containers.d.ts",
      "default": "./dist/containers.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@broker/clock": "workspace:*",
    "@broker/domain-kernel": "workspace:*",
    "@broker/ids": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "testcontainers": "12.2.0"
  },
  "devDependencies": {
    "@broker/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
