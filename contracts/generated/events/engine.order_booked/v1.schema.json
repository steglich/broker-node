{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:engine.order_booked:v1",
  "title": "engine.order_booked v1",
  "description": "Ordem entrou (ou voltou) no livro; `price` nulo é `MARKET` em leilão (Motor §9).",
  "x-producer": "matching-engine",
  "x-auditable": false,
  "type": "object",
  "required": [
    "instrumentId",
    "board",
    "engineSeq",
    "inputSeq",
    "orderId",
    "price",
    "remainingQuantity",
    "prioritySeq"
  ],
  "properties": {
    "instrumentId": {
      "type": "string",
      "format": "uuid"
    },
    "board": {
      "anyOf": [
        {
          "type": "string",
          "const": "MAIN"
        },
        {
          "type": "string",
          "const": "ODD_LOT"
        }
      ]
    },
    "engineSeq": {
      "type": "integer",
      "minimum": 1
    },
    "inputSeq": {
      "type": "integer",
      "minimum": 1
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "price": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,8})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "remainingQuantity": {
      "type": "integer",
      "minimum": 1
    },
    "prioritySeq": {
      "type": "integer",
      "minimum": 1
    }
  }
}
