{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:ledger.journal_posted:v1",
  "title": "ledger.journal_posted v1",
  "description": "Lançamento contábil gravado, com as entradas e as sequências por conta (RN-LED-031).",
  "x-producer": "ledger-service",
  "x-auditable": false,
  "type": "object",
  "required": [
    "journalId",
    "type",
    "referenceType",
    "referenceId",
    "bookingDate",
    "entries"
  ],
  "properties": {
    "journalId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string"
    },
    "referenceType": {
      "type": "string"
    },
    "referenceId": {
      "type": "string"
    },
    "bookingDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "accountCode",
          "ownerId",
          "amount",
          "valueDate",
          "status",
          "sequence"
        ],
        "properties": {
          "accountCode": {
            "type": "string"
          },
          "ownerId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,2})?$"
          },
          "valueDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "const": "PENDING"
              },
              {
                "type": "string",
                "const": "SETTLED"
              }
            ]
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "minItems": 2
    }
  }
}
