{
  "name": "@broker/identity-service",
  "version": "0.0.0",
  "private": true,
  "description": "Identidade e acesso dos realms customers e backoffice: credenciais, bloqueio, MFA (TOTP, WebAuthn, SMS), Authorization Code + PKCE, tokens ES256 com JWKS rotacionável, refresh com rotação, sessões, assinatura eletrônica, step-up, recuperação de acesso, RBAC com segregação e client credentials (Autenticação §1–§5).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@broker/clock": "workspace:*",
    "@broker/contracts": "workspace:*",
    "@broker/domain-kernel": "workspace:*",
    "@broker/ids": "workspace:*",
    "@broker/messaging": "workspace:*",
    "@broker/persistence": "workspace:*",
    "@broker/service-kit": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "express": "5.2.1",
    "iovalkey": "0.4.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "nodemailer": "10.0.16",
    "otplib": "13.5.0",
    "pg": "^8.23.1",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@broker/testing": "workspace:*",
    "@broker/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
