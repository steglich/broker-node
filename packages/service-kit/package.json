{
  "name": "@broker/service-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Bootstrap Express dos serviços: config, contexto, erros RFC 9457, idempotência, logs, traces, métricas, autenticação, RPC, paginação, sagas e feature flags.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "source": "./src/register.ts",
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@broker/clock": "workspace:*",
    "@broker/domain-kernel": "workspace:*",
    "@broker/ids": "workspace:*",
    "@broker/messaging": "workspace:*",
    "@broker/persistence": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/instrumentation-amqplib": "0.70.0",
    "@opentelemetry/instrumentation-express": "0.71.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "import-in-the-middle": "3.5.2",
    "iovalkey": "0.4.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "opossum": "10.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "typebox": "1.3.34",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@broker/testing": "workspace:*",
    "@broker/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/opossum": "8.1.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
