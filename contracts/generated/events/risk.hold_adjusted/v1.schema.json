{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:risk.hold_adjusted:v1",
  "title": "risk.hold_adjusted v1",
  "description": "Reserva reduzida por execução ou cancelamento parcial, ou refeita numa alteração (RN-HLD-004).",
  "x-producer": "risk-service",
  "x-auditable": false,
  "type": "object",
  "required": [
    "holdId",
    "accountId",
    "type",
    "resource",
    "amount",
    "reference"
  ],
  "properties": {
    "holdId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "anyOf": [
        {
          "type": "string",
          "const": "ORDER_CASH"
        },
        {
          "type": "string",
          "const": "ORDER_POSITION"
        },
        {
          "type": "string",
          "const": "ORDER_MARGIN"
        },
        {
          "type": "string",
          "const": "WITHDRAWAL"
        },
        {
          "type": "string",
          "const": "BTC_COLLATERAL"
        },
        {
          "type": "string",
          "const": "BTC_LENT"
        }
      ]
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": "string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    },
    "reference": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
