{
  "openapi": "3.1.0",
  "info": {
    "title": "Notificações",
    "version": "1.0.0",
    "description": "Gerado de contracts/http (D8). Não edite à mão: rode `pnpm contracts:generate`."
  },
  "paths": {
    "/v1/me/notifications": {
      "get": {
        "operationId": "list",
        "summary": "Central in-app: mais recentes primeiro, 90 dias (RN-NOT-G-008).",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d+$"
            }
          },
          {
            "name": "unread",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "true"
                },
                {
                  "type": "string",
                  "const": "false"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página da central e o total de não lidas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "unreadCount"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "code",
                          "title",
                          "body",
                          "data",
                          "priority",
                          "channels",
                          "createdAt",
                          "readAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "code": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]*$"
                          },
                          "title": {
                            "type": "string"
                          },
                          "body": {
                            "type": "string"
                          },
                          "data": {
                            "type": "object",
                            "patternProperties": {
                              "^.*$": {
                                "type": "string"
                              }
                            }
                          },
                          "priority": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "LOW"
                              },
                              {
                                "type": "string",
                                "const": "MEDIUM"
                              },
                              {
                                "type": "string",
                                "const": "HIGH"
                              },
                              {
                                "type": "string",
                                "const": "CRITICAL"
                              }
                            ]
                          },
                          "channels": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "const": "IN_APP"
                                },
                                {
                                  "type": "string",
                                  "const": "PUSH"
                                },
                                {
                                  "type": "string",
                                  "const": "EMAIL"
                                },
                                {
                                  "type": "string",
                                  "const": "SMS"
                                },
                                {
                                  "type": "string",
                                  "const": "DESKTOP"
                                }
                              ]
                            }
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "readAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "type": "string"
                    },
                    "unreadCount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/me/notifications/read": {
      "post": {
        "operationId": "markRead",
        "summary": "Marca como lidas: uma lista de IDs ou todas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "ids"
                    ],
                    "properties": {
                      "ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "minItems": 1,
                        "maxItems": 200
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "all"
                    ],
                    "properties": {
                      "all": {
                        "type": "boolean",
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quantas passaram a lidas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "updated"
                  ],
                  "properties": {
                    "updated": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/me/notification-preferences": {
      "get": {
        "operationId": "getPreferences",
        "summary": "Preferências por código e canal, horário de silêncio e \"ocultar valores\".",
        "responses": {
          "200": {
            "description": "Preferências.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "quietHours",
                    "hideValues"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "code",
                          "priority",
                          "canDisable",
                          "channels"
                        ],
                        "properties": {
                          "code": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]*$"
                          },
                          "priority": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "LOW"
                              },
                              {
                                "type": "string",
                                "const": "MEDIUM"
                              },
                              {
                                "type": "string",
                                "const": "HIGH"
                              },
                              {
                                "type": "string",
                                "const": "CRITICAL"
                              }
                            ]
                          },
                          "canDisable": {
                            "type": "boolean"
                          },
                          "channels": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "channel",
                                "enabled"
                              ],
                              "properties": {
                                "channel": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "const": "IN_APP"
                                    },
                                    {
                                      "type": "string",
                                      "const": "PUSH"
                                    },
                                    {
                                      "type": "string",
                                      "const": "EMAIL"
                                    },
                                    {
                                      "type": "string",
                                      "const": "SMS"
                                    },
                                    {
                                      "type": "string",
                                      "const": "DESKTOP"
                                    }
                                  ]
                                },
                                "enabled": {
                                  "type": "boolean"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "quietHours": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "start",
                            "end"
                          ],
                          "properties": {
                            "start": {
                              "type": "string",
                              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                            },
                            "end": {
                              "type": "string",
                              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "hideValues": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      },
      "put": {
        "operationId": "putPreferences",
        "summary": "Atualiza as preferências; sem `channel`, vale para todos os canais padrão do código.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "preferences": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "code",
                        "enabled"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "pattern": "^[A-Z][A-Z0-9_]*$"
                        },
                        "channel": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "IN_APP"
                            },
                            {
                              "type": "string",
                              "const": "PUSH"
                            },
                            {
                              "type": "string",
                              "const": "EMAIL"
                            },
                            {
                              "type": "string",
                              "const": "SMS"
                            },
                            {
                              "type": "string",
                              "const": "DESKTOP"
                            }
                          ]
                        },
                        "enabled": {
                          "type": "boolean"
                        }
                      }
                    },
                    "maxItems": 200
                  },
                  "quietHours": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "start",
                          "end"
                        ],
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "hideValues": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferências atualizadas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "quietHours",
                    "hideValues"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "code",
                          "priority",
                          "canDisable",
                          "channels"
                        ],
                        "properties": {
                          "code": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]*$"
                          },
                          "priority": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "LOW"
                              },
                              {
                                "type": "string",
                                "const": "MEDIUM"
                              },
                              {
                                "type": "string",
                                "const": "HIGH"
                              },
                              {
                                "type": "string",
                                "const": "CRITICAL"
                              }
                            ]
                          },
                          "canDisable": {
                            "type": "boolean"
                          },
                          "channels": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "channel",
                                "enabled"
                              ],
                              "properties": {
                                "channel": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "const": "IN_APP"
                                    },
                                    {
                                      "type": "string",
                                      "const": "PUSH"
                                    },
                                    {
                                      "type": "string",
                                      "const": "EMAIL"
                                    },
                                    {
                                      "type": "string",
                                      "const": "SMS"
                                    },
                                    {
                                      "type": "string",
                                      "const": "DESKTOP"
                                    }
                                  ]
                                },
                                "enabled": {
                                  "type": "boolean"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "quietHours": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "start",
                            "end"
                          ],
                          "properties": {
                            "start": {
                              "type": "string",
                              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                            },
                            "end": {
                              "type": "string",
                              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                            }
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "hideValues": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "`NOTIFICATION_NOT_OPTIONAL` (obrigatória), `UNKNOWN_NOTIFICATION_CODE` ou canal fora dos padrões.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/me/push-devices": {
      "post": {
        "operationId": "registerPushDevice",
        "summary": "Registra (ou renova) o token de push do aparelho; cifrado no banco.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "platform",
                  "token"
                ],
                "properties": {
                  "platform": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "IOS"
                      },
                      {
                        "type": "string",
                        "const": "ANDROID"
                      }
                    ]
                  },
                  "token": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 4096
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Já registrado: renovado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Registrado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "description": "Problem Details (RFC 9457, RN-BE-030).",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "context": {
            "type": "object"
          }
        }
      }
    },
    "securitySchemes": {
      "user": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "service": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
