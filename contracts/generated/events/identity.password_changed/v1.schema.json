{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:identity.password_changed:v1",
  "title": "identity.password_changed v1",
  "description": "Senha trocada (troca ou recuperação de acesso).",
  "x-producer": "identity-service",
  "x-auditable": true,
  "type": "object",
  "required": [
    "userId",
    "at"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
