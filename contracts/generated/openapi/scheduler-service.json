{
  "openapi": "3.1.0",
  "info": {
    "title": "scheduler-service",
    "version": "1.0.0",
    "description": "Gerado de contracts/http (D8). Não edite à mão: rode `pnpm contracts:generate`."
  },
  "paths": {
    "/v1/clock": {
      "get": {
        "operationId": "getClock",
        "summary": "O relógio do ambiente (RN-CLK-002).",
        "responses": {
          "200": {
            "description": "Modo e instante atual.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mode",
                    "now",
                    "businessDate",
                    "speedFactor",
                    "leader"
                  ],
                  "properties": {
                    "mode": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "REAL"
                        },
                        {
                          "type": "string",
                          "const": "ACCELERATED"
                        },
                        {
                          "type": "string",
                          "const": "VIRTUAL"
                        }
                      ]
                    },
                    "now": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "businessDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "speedFactor": {
                      "type": "number"
                    },
                    "leader": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/clock/advance": {
      "post": {
        "operationId": "advanceClock",
        "summary": "advance_to(t): só no modo VIRTUAL; dispara as rotinas do caminho em ordem. Admin.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "to"
                ],
                "properties": {
                  "to": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Relógio no instante pedido.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mode",
                    "now",
                    "businessDate",
                    "speedFactor",
                    "leader"
                  ],
                  "properties": {
                    "mode": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "REAL"
                        },
                        {
                          "type": "string",
                          "const": "ACCELERATED"
                        },
                        {
                          "type": "string",
                          "const": "VIRTUAL"
                        }
                      ]
                    },
                    "now": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "businessDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "speedFactor": {
                      "type": "number"
                    },
                    "leader": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "CLOCK_MODE_NOT_VIRTUAL ou CLOCK_CANNOT_GO_BACK.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "NOT_LEADER: a instância está em espera.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/routines": {
      "get": {
        "operationId": "listRoutines",
        "summary": "A tabela de rotinas (Pregão §8).",
        "responses": {
          "200": {
            "description": "Rotinas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "routines"
                  ],
                  "properties": {
                    "routines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "owner",
                          "schedule",
                          "days",
                          "dependsOn",
                          "enabled"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$"
                          },
                          "owner": {
                            "type": "string"
                          },
                          "schedule": {
                            "anyOf": [
                              {
                                "type": "object",
                                "required": [
                                  "at"
                                ],
                                "properties": {
                                  "at": {
                                    "type": "string"
                                  }
                                }
                              },
                              {
                                "type": "object",
                                "required": [
                                  "phase"
                                ],
                                "properties": {
                                  "phase": {
                                    "type": "string"
                                  },
                                  "offsetMinutes": {
                                    "type": "integer"
                                  }
                                }
                              }
                            ]
                          },
                          "days": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "TRADING"
                              },
                              {
                                "type": "string",
                                "const": "FIRST_BUSINESS_DAY_OF_MONTH"
                              }
                            ]
                          },
                          "dependsOn": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9_]*$"
                            }
                          },
                          "enabled": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/routine-executions": {
      "get": {
        "operationId": "listExecutions",
        "summary": "Execuções por período de datas de negócio (até 1 ano).",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Execuções.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "executions"
                  ],
                  "properties": {
                    "executions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "routineName",
                          "businessDate",
                          "status",
                          "executionId",
                          "attempt",
                          "scheduledFor",
                          "triggeredAt",
                          "completedAt",
                          "failureReason",
                          "catchUp"
                        ],
                        "properties": {
                          "routineName": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]*$"
                          },
                          "businessDate": {
                            "type": "string",
                            "format": "date"
                          },
                          "status": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "TRIGGERED"
                              },
                              {
                                "type": "string",
                                "const": "COMPLETED"
                              },
                              {
                                "type": "string",
                                "const": "FAILED"
                              }
                            ]
                          },
                          "executionId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "attempt": {
                            "type": "integer"
                          },
                          "scheduledFor": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "triggeredAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "completedAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "failureReason": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "catchUp": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/routine-executions/{routineName}/{businessDate}/retry": {
      "post": {
        "operationId": "retryExecution",
        "summary": "Novo disparo de uma rotina FAILED (executionId novo). Admin.",
        "parameters": [
          {
            "name": "routineName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          {
            "name": "businessDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Disparada de novo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "routineName",
                    "businessDate",
                    "status",
                    "executionId",
                    "attempt",
                    "scheduledFor",
                    "triggeredAt",
                    "completedAt",
                    "failureReason",
                    "catchUp"
                  ],
                  "properties": {
                    "routineName": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "businessDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "TRIGGERED"
                        },
                        {
                          "type": "string",
                          "const": "COMPLETED"
                        },
                        {
                          "type": "string",
                          "const": "FAILED"
                        }
                      ]
                    },
                    "executionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "attempt": {
                      "type": "integer"
                    },
                    "scheduledFor": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "triggeredAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "completedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "failureReason": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "catchUp": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "ROUTINE_NOT_FAILED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/routine-executions/{routineName}/{businessDate}/result": {
      "post": {
        "operationId": "reportResult",
        "summary": "Registra o resultado de uma execução à mão, como se fosse o routine.completed/failed do dono. Admin.",
        "parameters": [
          {
            "name": "routineName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          {
            "name": "businessDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "executionId",
                  "status"
                ],
                "properties": {
                  "executionId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "status": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "COMPLETED"
                      },
                      {
                        "type": "string",
                        "const": "FAILED"
                      }
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Registrado."
          },
          "404": {
            "description": "Execução inexistente.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "EXECUTION_STALE: executionId de uma tentativa anterior.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "description": "Problem Details (RFC 9457, RN-BE-030).",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "context": {
            "type": "object"
          }
        }
      }
    },
    "securitySchemes": {
      "user": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "service": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
