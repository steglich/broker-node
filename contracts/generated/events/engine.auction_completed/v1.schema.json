{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:engine.auction_completed:v1",
  "title": "engine.auction_completed v1",
  "description": "Leilão concluído no Motor, com preço e quantidade (RN-AUC-020..022).",
  "x-producer": "matching-engine",
  "x-auditable": false,
  "type": "object",
  "required": [
    "instrumentId",
    "board",
    "engineSeq",
    "inputSeq",
    "auctionId",
    "price",
    "quantity"
  ],
  "properties": {
    "instrumentId": {
      "type": "string",
      "format": "uuid"
    },
    "board": {
      "anyOf": [
        {
          "type": "string",
          "const": "MAIN"
        },
        {
          "type": "string",
          "const": "ODD_LOT"
        }
      ]
    },
    "engineSeq": {
      "type": "integer",
      "minimum": 1
    },
    "inputSeq": {
      "type": "integer",
      "minimum": 1
    },
    "auctionId": {
      "type": "string",
      "format": "uuid"
    },
    "price": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,8})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    }
  }
}
