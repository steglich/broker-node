{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:market_data.symbol_rename_detected:v1",
  "title": "market_data.symbol_rename_detected v1",
  "description": "A brapi informou troca de ticker (renames/resolve, RN-INS-030..033).",
  "x-producer": "market-data-service",
  "x-auditable": false,
  "type": "object",
  "required": [
    "oldSymbol",
    "newSymbol",
    "effectiveDate"
  ],
  "properties": {
    "oldSymbol": {
      "type": "string"
    },
    "newSymbol": {
      "type": "string"
    },
    "effectiveDate": {
      "type": "string",
      "format": "date"
    },
    "conversionRatio": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,8})?$"
    }
  }
}
