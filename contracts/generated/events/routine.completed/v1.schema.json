{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:routine.completed:v1",
  "title": "routine.completed v1",
  "description": "A rotina terminou na data; libera as rotinas que dependem dela (RN-ROT-002).",
  "x-producer": "routine-owner",
  "x-auditable": false,
  "type": "object",
  "required": [
    "routineName",
    "businessDate",
    "executionId"
  ],
  "properties": {
    "routineName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "businessDate": {
      "type": "string",
      "format": "date"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "stats": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    }
  }
}
