{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:smm.instrument_activated:v1",
  "title": "smm.instrument_activated v1",
  "description": "Instrumento ativado no FMS, uma vez só: a custódia registra o estoque inicial, retroativo na Fase 3 (RN-SMM-020, RN-INS-014).",
  "x-producer": "market-maker-service",
  "x-auditable": true,
  "type": "object",
  "required": [
    "instrumentId",
    "symbol",
    "accountId",
    "initialStock",
    "activatedAt"
  ],
  "properties": {
    "instrumentId": {
      "type": "string",
      "format": "uuid"
    },
    "symbol": {
      "type": "string"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "initialStock": {
      "type": "integer",
      "minimum": 1
    },
    "activatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
