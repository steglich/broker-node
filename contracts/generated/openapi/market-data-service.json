{
  "openapi": "3.1.0",
  "info": {
    "title": "market-data-service",
    "version": "1.0.0",
    "description": "Gerado de contracts/http (D8). Não edite à mão: rode `pnpm contracts:generate`."
  },
  "paths": {
    "/v1/market-data/external-quotes/{symbol}": {
      "get": {
        "operationId": "externalQuote",
        "summary": "Cotação externa de qualquer ticker (P3): cache de 30 min, fila coalescida com espera de 5 s e, se a fonte demorar, a última gravada com aviso (RN-BRP-042/043, RN-BRP-006).",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\^?[A-Za-z0-9.]{2,12}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cotação, de onde veio e a atribuição \"Fonte: brapi.dev\".",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "quote",
                    "servedFrom",
                    "attribution"
                  ],
                  "properties": {
                    "quote": {
                      "type": "object",
                      "required": [
                        "symbol",
                        "instrumentId",
                        "kind",
                        "quote",
                        "fetchedAt",
                        "provider",
                        "stale",
                        "staleSince"
                      ],
                      "properties": {
                        "symbol": {
                          "type": "string"
                        },
                        "instrumentId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "uuid"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "kind": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "INSTRUMENT"
                            },
                            {
                              "type": "string",
                              "const": "INDEX"
                            }
                          ]
                        },
                        "quote": {
                          "type": "object",
                          "required": [
                            "symbol",
                            "requestedSymbol",
                            "changed",
                            "lastPrice",
                            "quoteTime",
                            "open",
                            "high",
                            "low",
                            "previousClose",
                            "change",
                            "changePercent",
                            "volume",
                            "marketCap",
                            "week52Low",
                            "week52High",
                            "currency",
                            "shortName",
                            "longName",
                            "logoUrl"
                          ],
                          "properties": {
                            "symbol": {
                              "type": "string"
                            },
                            "requestedSymbol": {
                              "type": "string"
                            },
                            "changed": {
                              "type": "boolean"
                            },
                            "lastPrice": {
                              "type": "string",
                              "pattern": "^-?\\d+(\\.\\d+)?$"
                            },
                            "quoteTime": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "open": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "high": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "low": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "previousClose": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "change": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "changePercent": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "volume": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "marketCap": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "week52Low": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "week52High": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^-?\\d+(\\.\\d+)?$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "currency": {
                              "type": "string",
                              "const": "BRL"
                            },
                            "shortName": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "longName": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "logoUrl": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          }
                        },
                        "fetchedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "provider": {
                          "type": "string"
                        },
                        "stale": {
                          "type": "boolean"
                        },
                        "staleSince": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "servedFrom": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "PROVIDER"
                        },
                        {
                          "type": "string",
                          "const": "CACHE"
                        },
                        {
                          "type": "string",
                          "const": "STORED"
                        }
                      ]
                    },
                    "attribution": {
                      "type": "string"
                    },
                    "warning": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "QUOTE_NOT_FOUND: a fonte não tem o ticker.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "QUOTE_UNAVAILABLE: sem cotação gravada e a fonte indisponível.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/market-data/history/{symbol}": {
      "get": {
        "operationId": "dailyHistory",
        "summary": "Candles diários externos (E3, cache de 24 h; em SAVING só o gravado).",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\^?[A-Za-z0-9.]{2,12}$"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candles em ordem de data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "symbol",
                    "items",
                    "fetchedAt",
                    "fromCache",
                    "attribution"
                  ],
                  "properties": {
                    "symbol": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "date",
                          "open",
                          "high",
                          "low",
                          "close",
                          "adjustedClose",
                          "volume",
                          "source"
                        ],
                        "properties": {
                          "date": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          "open": {
                            "type": "string",
                            "pattern": "^-?\\d+(\\.\\d+)?$"
                          },
                          "high": {
                            "type": "string",
                            "pattern": "^-?\\d+(\\.\\d+)?$"
                          },
                          "low": {
                            "type": "string",
                            "pattern": "^-?\\d+(\\.\\d+)?$"
                          },
                          "close": {
                            "type": "string",
                            "pattern": "^-?\\d+(\\.\\d+)?$"
                          },
                          "adjustedClose": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^-?\\d+(\\.\\d+)?$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "volume": {
                            "type": "string",
                            "pattern": "^-?\\d+(\\.\\d+)?$"
                          },
                          "source": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "fetchedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fromCache": {
                      "type": "boolean"
                    },
                    "attribution": {
                      "type": "string"
                    },
                    "warning": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/market-data/reference-prices/{instrumentId}": {
      "get": {
        "operationId": "referencePrice",
        "summary": "Último preço de referência publicado do instrumento (Brapi §8).",
        "parameters": [
          {
            "name": "instrumentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Referência.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "instrumentId",
                    "price",
                    "origin",
                    "anchorPrice",
                    "externalQuoteTime",
                    "seq",
                    "tradingDate",
                    "noiseEnabled"
                  ],
                  "properties": {
                    "instrumentId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "price": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "origin": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "anchorPrice": {
                      "type": "string"
                    },
                    "externalQuoteTime": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "seq": {
                      "type": "integer"
                    },
                    "tradingDate": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "noiseEnabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "REFERENCE_NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/bo/market-data/provider": {
      "get": {
        "operationId": "providerState",
        "summary": "Painel do provedor: orçamento (nível, restante, projeção), disjuntor, fila por prioridade e liderança (Brapi §11).",
        "responses": {
          "200": {
            "description": "Estado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "provider",
                    "leader",
                    "budget",
                    "circuit",
                    "queueDepth",
                    "staleInstruments"
                  ],
                  "properties": {
                    "provider": {
                      "type": "string"
                    },
                    "leader": {
                      "type": "boolean"
                    },
                    "budget": {
                      "type": "object",
                      "required": [
                        "level",
                        "metered",
                        "remaining",
                        "reserve",
                        "businessDayBudget",
                        "nonBusinessDayBudget",
                        "projectedExhaustion",
                        "planLimit",
                        "windowEnd",
                        "usageReadAt"
                      ],
                      "properties": {
                        "level": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": "NORMAL"
                            },
                            {
                              "type": "string",
                              "const": "SAVING"
                            },
                            {
                              "type": "string",
                              "const": "CRITICAL"
                            },
                            {
                              "type": "string",
                              "const": "EXHAUSTED"
                            }
                          ]
                        },
                        "metered": {
                          "type": "boolean"
                        },
                        "remaining": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "reserve": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "businessDayBudget": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "nonBusinessDayBudget": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "projectedExhaustion": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "planLimit": {
                          "anyOf": [
                            {
                              "type": "integer"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "windowEnd": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "usageReadAt": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    "circuit": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "CLOSED"
                        },
                        {
                          "type": "string",
                          "const": "OPEN"
                        },
                        {
                          "type": "string",
                          "const": "HALF_OPEN"
                        }
                      ]
                    },
                    "queueDepth": {
                      "type": "object",
                      "patternProperties": {
                        "^.*$": {
                          "type": "integer"
                        }
                      }
                    },
                    "staleInstruments": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/bo/market-data/alerts": {
      "get": {
        "operationId": "providerAlerts",
        "summary": "Alertas do provedor (401, cota, quarentena, descontinuação, esquema), do mais novo.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Alertas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "kind",
                          "severity",
                          "message",
                          "data",
                          "createdAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "kind": {
                            "type": "string"
                          },
                          "severity": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "INFO"
                              },
                              {
                                "type": "string",
                                "const": "WARNING"
                              },
                              {
                                "type": "string",
                                "const": "CRITICAL"
                              }
                            ]
                          },
                          "message": {
                            "type": "string"
                          },
                          "data": {
                            "type": "object",
                            "patternProperties": {
                              "^.*$": {}
                            }
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/bo/market-data/reference-overrides": {
      "post": {
        "operationId": "createReferenceOverride",
        "summary": "Fixa o preço de referência por um período (origin = MANUAL, RN-SYN-006).",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "instrumentId",
                  "price",
                  "durationMinutes",
                  "reason"
                ],
                "properties": {
                  "instrumentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "price": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,4})?$"
                  },
                  "durationMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1440
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Override criado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "overrideId",
                    "instrumentId",
                    "price",
                    "validFrom",
                    "validUntil"
                  ],
                  "properties": {
                    "overrideId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "instrumentId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "price": {
                      "type": "string"
                    },
                    "validFrom": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "validUntil": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "INSTRUMENT_NOT_FOUND.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "NOT_TRADABLE: só o universo negociável tem referência.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/bo/market-data/reference-noise/{instrumentId}": {
      "put": {
        "operationId": "setReferenceNoise",
        "summary": "Liga ou desliga o ruído sintético de um instrumento (RN-SYN-004).",
        "parameters": [
          {
            "name": "instrumentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configurado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "instrumentId",
                    "enabled"
                  ],
                  "properties": {
                    "instrumentId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/bo/market-data/provider/auth-block/clear": {
      "post": {
        "operationId": "clearAuthBlock",
        "summary": "Libera as requisições autenticadas depois de um 401 (após trocar o token, RN-BRP-094).",
        "responses": {
          "204": {
            "description": "Liberado."
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
