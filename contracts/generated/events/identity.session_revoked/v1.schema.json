{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:identity.session_revoked:v1",
  "title": "identity.session_revoked v1",
  "description": "Sessão encerrada: os tokens dela deixam de valer (RN-AUTH-013).",
  "x-producer": "identity-service",
  "x-auditable": true,
  "type": "object",
  "required": [
    "userId",
    "sessionId",
    "reason"
  ],
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    }
  }
}
