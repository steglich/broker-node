{
  "name": "@broker/simulator-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Base dos simuladores externos: comportamento configurável (latência, erros, indisponibilidade), cenários forçáveis e UI de inspeção (RN-SIM-002/005).",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@broker/clock": "workspace:*",
    "@broker/domain-kernel": "workspace:*",
    "@broker/service-kit": "workspace:*",
    "@broker/webhooks": "workspace:*",
    "express": "5.2.1",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@broker/testing": "workspace:*",
    "@broker/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
