{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:session.halt_ended:v1",
  "title": "session.halt_ended v1",
  "description": "Fim de uma suspensão; a retomada segue por leilão (RN-HLT-002).",
  "x-producer": "trading-session-service",
  "x-auditable": true,
  "type": "object",
  "required": [
    "haltId",
    "scope",
    "reasonCode"
  ],
  "properties": {
    "haltId": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string",
          "const": "MARKET"
        },
        {
          "type": "string",
          "format": "uuid"
        }
      ]
    },
    "reasonCode": {
      "type": "string"
    }
  }
}
