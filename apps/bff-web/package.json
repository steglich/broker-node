{
  "name": "@broker/bff-web",
  "version": "0.0.0",
  "private": true,
  "description": "BFF do canal web: token handler (Authorization Code + PKCE, cookies HttpOnly/SameSite=Strict, anti-CSRF), rotas /v1/me com a conta do token, agregação sem N+1 e auditoria de acesso a dados pessoais (RN-AUTH-010, RN-API-043, RN-PAD-010/011).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@broker/clock": "workspace:*",
    "@broker/contracts": "workspace:*",
    "@broker/domain-kernel": "workspace:*",
    "@broker/ids": "workspace:*",
    "@broker/messaging": "workspace:*",
    "@broker/persistence": "workspace:*",
    "@broker/service-kit": "workspace:*",
    "iovalkey": "0.4.0",
    "kysely": "0.29.6",
    "pg": "^8.23.1",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@broker/testing": "workspace:*",
    "@broker/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "7.2.1",
    "express": "5.2.1",
    "jose": "6.2.12",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
