{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:broker:event:order.rejected:v1",
  "title": "order.rejected v1",
  "description": "Ordem recusada pelo OMS, Risco ou Motor; sem execução, o Risco libera o hold (RN-FLX-002).",
  "x-producer": "oms-service",
  "x-auditable": false,
  "type": "object",
  "required": [
    "orderId",
    "accountId",
    "rejectCode"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "rejectCode": {
      "type": "string",
      "minLength": 1
    },
    "figures": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    }
  }
}
