{
  "openapi": "3.1.0",
  "info": {
    "title": "BFF web",
    "version": "1.0.0",
    "description": "Gerado de contracts/http (D8). Não edite à mão: rode `pnpm contracts:generate`."
  },
  "paths": {
    "/v1/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Login (Authorization Code + PKCE conduzido pelo BFF): tokens em cookies HttpOnly/Secure/SameSite=Strict (RN-AUTH-010).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticado ou desafio de MFA; nenhum token no corpo.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "expiresIn",
                        "csrfToken"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "AUTHENTICATED"
                        },
                        "expiresIn": {
                          "type": "integer"
                        },
                        "csrfToken": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "methods",
                        "expiresAt"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "MFA_REQUIRED"
                        },
                        "methods": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "LOGIN_TEMPORARILY_LOCKED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/mfa/verify": {
      "post": {
        "operationId": "mfaVerify",
        "summary": "Segunda etapa do login (o desafio fica no cookie cifrado do BFF).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "method",
                      "code"
                    ],
                    "properties": {
                      "method": {
                        "type": "string",
                        "const": "TOTP"
                      },
                      "code": {
                        "type": "string",
                        "pattern": "^\\d{6}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "method",
                      "response"
                    ],
                    "properties": {
                      "method": {
                        "type": "string",
                        "const": "WEBAUTHN"
                      },
                      "response": {
                        "type": "object",
                        "patternProperties": {
                          "^.*$": {}
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "expiresIn",
                        "csrfToken"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "AUTHENTICATED"
                        },
                        "expiresIn": {
                          "type": "integer"
                        },
                        "csrfToken": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "methods",
                        "expiresAt"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "MFA_REQUIRED"
                        },
                        "methods": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "INVALID_MFA, MFA_CHALLENGE_EXPIRED ou LOGIN_EXPIRED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/mfa/webauthn-options": {
      "post": {
        "operationId": "mfaWebauthnOptions",
        "summary": "Desafio WebAuthn da etapa de MFA.",
        "responses": {
          "200": {
            "description": "PublicKeyCredentialRequestOptions."
          }
        },
        "security": []
      }
    },
    "/v1/auth/token/refresh": {
      "post": {
        "operationId": "refresh",
        "summary": "Renova os cookies com o refresh token (rotação; reuso encerra a sessão).",
        "responses": {
          "200": {
            "description": "Renovado.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "expiresIn",
                        "csrfToken"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "AUTHENTICATED"
                        },
                        "expiresIn": {
                          "type": "integer"
                        },
                        "csrfToken": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "methods",
                        "expiresAt"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "const": "MFA_REQUIRED"
                        },
                        "methods": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Sessão encerrada: cookies limpos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Revoga a sessão no identity e limpa os cookies.",
        "responses": {
          "204": {
            "description": "Encerrada."
          }
        },
        "security": []
      }
    },
    "/v1/auth/session": {
      "get": {
        "operationId": "session",
        "summary": "Quem está logado e o token anti-CSRF (para o app recarregado).",
        "responses": {
          "200": {
            "description": "Sessão.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "userId",
                    "accountId",
                    "csrfToken",
                    "expiresAt"
                  ],
                  "properties": {
                    "userId": {
                      "type": "string"
                    },
                    "accountId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "csrfToken": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/me/step-up": {
      "post": {
        "operationId": "stepUp",
        "summary": "Step-up (RN-AUTHZ-003): o access token novo vai para o cookie.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "method",
                      "code"
                    ],
                    "properties": {
                      "method": {
                        "type": "string",
                        "const": "TOTP"
                      },
                      "code": {
                        "type": "string",
                        "pattern": "^\\d{6}$"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "method",
                      "response"
                    ],
                    "properties": {
                      "method": {
                        "type": "string",
                        "const": "WEBAUTHN"
                      },
                      "response": {
                        "type": "object",
                        "patternProperties": {
                          "^.*$": {}
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feito.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "expiresIn"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "STEPPED_UP"
                    },
                    "expiresIn": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/me/trading-signature/verify": {
      "post": {
        "operationId": "verifySignature",
        "summary": "Assinatura eletrônica: o token de curta duração fica num cookie HttpOnly do escopo e é anexado aos comandos (RN-SIG-003).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "secret",
                  "scope"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "scope": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "ORDERS"
                      },
                      {
                        "type": "string",
                        "const": "WITHDRAWALS"
                      },
                      {
                        "type": "string",
                        "const": "SETTINGS"
                      }
                    ]
                  },
                  "rememberInSession": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validade do token (que não aparece no corpo).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "scope",
                    "expiresAt"
                  ],
                  "properties": {
                    "scope": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
