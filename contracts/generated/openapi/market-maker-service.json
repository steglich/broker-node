    "/v1/bo/smm/{instrumentId}": {
      "get": {
        "operationId": "state",
        "summary": "Inventário, P&L, spread efetivo, ofertas e parâmetros (RN-SMM-031).",
        "parameters": [
          {
            "name": "instrumentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "instrumentId",
                    "symbol",
                    "accountId",
                    "enabled",
                    "globalEnabled",
                    "stopped",
                    "initialStock",
                    "reference",
                    "spreadMultiplier",
                    "liveOrders",
                    "parameters",
                    "metrics"
                  ],
                  "properties": {
                    "instrumentId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "symbol": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "accountId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "globalEnabled": {
                      "type": "boolean"
                    },
                    "stopped": {
                      "type": "boolean"
                    },
                    "initialStock": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reference": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "spreadMultiplier": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "liveOrders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "orderId",
                          "board",
                          "side",
                          "price",
                          "remaining",
                          "status"
                        ],
                        "properties": {
                          "orderId": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "board": {
                            "type": "string"
                          },
                          "side": {
                            "type": "string"
                          },
                          "price": {
                            "type": "string"
                          },
                          "remaining": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "status": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "parameters": {
                      "type": "object",
                      "patternProperties": {
                        "^.*$": {}
                      }
                    },
                    "metrics": {
                      "type": "object",
                      "required": [
                        "instrumentId",
                        "inventory",
                        "realizedPnl",
                        "unrealizedPnl",
                        "volume",
                        "requotes",
                        "effectiveSpreadBps",
                        "quotedSeconds",
                        "bestBid",
                        "bestAsk",
                        "at"
                      ],
                      "properties": {
                        "instrumentId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "inventory": {
                          "type": "integer"
                        },
                        "realizedPnl": {
                          "type": "string"
                        },
                        "unrealizedPnl": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "volume": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "requotes": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "effectiveSpreadBps": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "quotedSeconds": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "bestBid": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "bestAsk": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Instrumento sem FMS ativado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      },
      "put": {
        "operationId": "parameters",
        "summary": "Propõe nova vigência dos parâmetros `smm_*` (Backoffice §3).",
        "parameters": [
          {
            "name": "instrumentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "params",
                  "justification"
                ],
                "properties": {
                  "params": {
                    "type": "object",
                    "properties": {
                      "levels": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 20
                      },
                      "levelStepBps": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "baseQuantityLots": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "levelMultiplier": {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d{1,4})?$"
                      },
                      "inventoryLimitLots": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "skewFactor": {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d{1,4})?$"
                      },
                      "maxSweepLots": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "oddLotEnabled": {
                        "type": "boolean"
                      },
                      "requoteThresholdTicks": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "refreshIntervalS": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "minProperties": 1,
                    "additionalProperties": false
                  },
                  "justification": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Solicitação aberta.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "type",
                    "payload",
                    "justification",
                    "makerId",
                    "status",
                    "createdAt",
                    "expiresAt",
                    "decidedBy",
                    "decidedAt",
                    "decisionReason"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "type": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "SMM_ENABLE"
                        },
                        {
                          "type": "string",
                          "const": "SMM_PARAMETERS"
                        }
                      ]
