{
  "name": "broker-node",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project \"!infra\" --project \"!example-service-e2e\"",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "env:up": "node infra/scripts/env.mjs up",
    "env:down": "node infra/scripts/env.mjs down",
    "env:logs": "node infra/scripts/env.mjs logs",
    "env:ps": "node infra/scripts/env.mjs ps",
    "env:seed": "node infra/scripts/env.mjs seed",
    "test:infra": "vitest run --project infra --project example-service-e2e",
    "contracts:generate": "pnpm --filter @broker/contracts generate",
    "contracts:check": "pnpm --filter @broker/contracts check --",
    "scenarios": "pnpm --filter @broker/scenarios run run --"
  },
  "devDependencies": {
    "@broker/eslint-config": "workspace:*",
    "@broker/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
