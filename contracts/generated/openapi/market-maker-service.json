{
  "openapi": "3.1.0",
  "info": {
    "title": "market-maker-service",
    "version": "1.0.0",
    "description": "Gerado de contracts/http (D8). Não edite à mão: rode `pnpm contracts:generate`."
  },
  "paths": {
    "/v1/bo/smm/kill-switch": {
      "post": {
        "operationId": "killSwitch",
        "summary": "Desliga o FMS, por instrumento ou global, ou propõe religar (RN-SMM-030).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enabled",
                  "justification"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "instrumentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "justification": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Desligado; todas as ofertas do escopo canceladas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "scope",
                    "status"
                  ],
                  "properties": {
                    "scope": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "const": "OFF"
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Solicitação de religar aberta.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "type",
                    "payload",
                    "justification",
                    "makerId",
                    "status",
                    "createdAt",
                    "expiresAt",
                    "decidedBy",
                    "decidedAt",
                    "decisionReason"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "type": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "SMM_ENABLE"
                        },
                        {
                          "type": "string",
                          "const": "SMM_PARAMETERS"
                        }
                      ]
                    },
                    "payload": {
                      "type": "object",
                      "patternProperties": {
                        "^.*$": {}
                      }
                    },
                    "justification": {
                      "type": "string"
                    },
                    "makerId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "decidedBy": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "decidedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "decisionReason": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Instrumento sem FMS ativado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "O FMS já está ligado neste escopo.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
    "/v1/bo/smm/change-requests": {
      "get": {
        "operationId": "changeRequests",
        "summary": "Solicitações de religar e de parâmetros.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "PENDING"
                },
                {
                  "type": "string",
                  "const": "APPROVED"
                },
                {
                  "type": "string",
                  "const": "REJECTED"
                },
                {
                  "type": "string",
                  "const": "EXPIRED"
                },
                {
                  "type": "string",
                  "const": "CANCELED"
                },
                {
                  "type": "string",
                  "const": "STALE"
                }
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "type",
                          "payload",
                          "justification",
                          "makerId",
                          "status",
                          "createdAt",
                          "expiresAt",
                          "decidedBy",
                          "decidedAt",
                          "decisionReason"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "type": {
                            "anyOf": [
                              {
                                "type": "string",
                                "const": "SMM_ENABLE"
                              },
                              {
                                "type": "string",
                                "const": "SMM_PARAMETERS"
                              }
                            ]
                          },
                          "payload": {
                            "type": "object",
                            "patternProperties": {
                              "^.*$": {}
                            }
                          },
                          "justification": {
                            "type": "string"
                          },
                          "makerId": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "expiresAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "decidedBy": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "decidedAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "decisionReason": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "user": []
          }
        ]
      }
    },
