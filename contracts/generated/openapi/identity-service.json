    "/v1/me/trading-signature/verify": {
      "post": {
        "operationId": "verifySignature",
        "summary": "VerifyTradingSignature: token de assinatura do escopo, vinculado à sessão (5 min, ou até 8 h para ordens com rememberInSession).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "secret",
                  "scope"
                ],
                "properties": {
                  "secret": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "scope": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "ORDERS"
                      },
                      {
                        "type": "string",
                        "const": "WITHDRAWALS"
                      },
                      {
                        "type": "string",
                        "const": "SETTINGS"
                      }
                    ]
                  },
                  "rememberInSession": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token de assinatura (header X-Trading-Signature nos comandos).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "signatureToken",
                    "scope",
                    "expiresAt"
                  ],
                  "properties": {
                    "signatureToken": {
                      "type": "string"
                    },
                    "scope": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "ORDERS"
                        },
                        {
                          "type": "string",
                          "const": "WITHDRAWALS"
                        },
                        {
                          "type": "string",
                          "const": "SETTINGS"
                        }
                      ]
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "INVALID_SIGNATURE.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "423": {
            "description": "SIGNATURE_LOCKED, SIGNATURE_RESET_REQUIRED ou SIGNATURE_BLOCKED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
